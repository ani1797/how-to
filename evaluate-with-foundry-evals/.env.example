# ---------------------------------------------------------------------------
# Azure AI Foundry project (used for cloud eval logging + risk & safety evaluators)
# Portal: your Foundry project > Overview > "Azure AI Foundry project endpoint"
# ---------------------------------------------------------------------------
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# ---------------------------------------------------------------------------
# Judge model deployment (used by AI-assisted quality evaluators)
# An Azure OpenAI chat deployment. Classic (gpt-4o, gpt-4.1) and reasoning
# (gpt-5.x, o-series) models both work — reasoning models are handled by the
# bundled sitecustomize.py shim (see README).
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: only needed if you authenticate the judge model with a key instead
# of DefaultAzureCredential / az login. Leave blank to use Entra ID auth.
AZURE_OPENAI_API_KEY=
